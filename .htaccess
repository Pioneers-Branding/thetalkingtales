RewriteEngine On

# Remove .php extension (internal rewrite)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# Redirect *.php → extensionless URL (external redirect)
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} \s/+([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L,NE]

# Redirect /index.php or /dir/index.php → / or /dir/
RewriteCond %{THE_REQUEST} \s/+(.*?/)index\.(php|html) [NC]
RewriteRule ^(.*?/)?index\.(php|html)$ /%1 [R=301,L]

Redirect 301 '/index' 'https://thetalkingtales.com/'